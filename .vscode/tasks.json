{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "debug"],
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "debug"],
            "dependsOn": "Configure Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "problemMatcher": []
        },
        {
            "label": "Configure Release",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "release"],
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "release"],
            "dependsOn": "Configure Release",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "problemMatcher": []
        },
        {
            "label": "Clean Debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "debug", "--target", "clean"],
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "problemMatcher": []
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "ctest",
            "args": ["--preset", "test"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "problemMatcher": []
        },
        {
            "label": "Cppcheck",
            "type": "shell",
            "command": "cppcheck",
            "args": [
                "--project=${workspaceFolder}/firmware/build/debug/compile_commands.json",
                "--error-exitcode=1", "--cppcheck-build-dir=${workspaceFolder}/firmware/build/cppcheck",
                "--enable=warning,style,performance,portability", "-i/opt/pico-sdk/", "-i/opt/pico-ili9488/",
                "--inline-suppr", "--suppressions-list=cppcheck.supp"],
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "problemMatcher": []
        },
        {
            "label": "Documentation",
            "type": "shell",
            "command": "doxygen",
            "args": ["${workspaceFolder}/firmware/Doxyfile"],
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "problemMatcher": []
        }
    ]
}